<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="ExportedContentProvider,ForegroundServicesPolicy,ScopedStorage,QueryAllPackagesPermission,PackageVisibilityPolicy,ProtectedPermissions,SystemPermissionTypo,UnusedAttribute">

    <!-- miuix-blur 声明的 minSdk 是 33（内部用了 RuntimeShader）。
         本项目要覆盖到 Android 8.0，因此强制合并；低版本由代码侧
         （GlassNavBar / SettingsPage）按 Build.VERSION 退回自绘，
         不会真正调用到 RuntimeShader。 -->
    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />

    <permission
        android:name="${applicationId}.permission.API"
        android:description="@string/permission_description"
        android:icon="@drawable/ic_launcher_foreground"
        android:label="@string/app_name"
        android:protectionLevel="dangerous" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />
    <!-- 关于页的更新检测需要联网读取版本清单 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.MANAGE_ACCOUNTS" />
    <!-- 免删激活：成为 DEVICE_POLICY_MANAGEMENT 角色持有者后，
         系统才会把这两个权限 grant 给本应用。必须先在清单里声明，
         否则 checkSelfPermission 永远返回 PERMISSION_DENIED，
         表现为「角色授予成功（RC=0）但角色未生效」。 -->
    <uses-permission android:name="android.permission.MANAGE_DEVICE_ADMINS" />
    <uses-permission android:name="android.permission.MANAGE_PROFILE_AND_DEVICE_OWNERS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.REQUEST_PASSWORD_COMPLEXITY" />

    <permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature"
        tools:node="remove" />

    <uses-permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <!-- LSPatch 修补目标应用时，请把它注入目标 manifest；主 App 自己声明一份，
         也便于修补器识别模块归属。Android 11+ 不声明就看不到本应用的 Provider。 -->
    <queries>
        <package android:name="com.neodhizuku.more" />
        <provider android:authorities="com.neodhizuku.more.dhizuku_server.provider" />
        <provider android:authorities="com.neodhizuku.more.hook.config" />
    </queries>

    <uses-feature
        android:name="android.software.device_admin"
        android:required="true" />

    <application
        android:name=".App"
        android:testOnly="${testOnly}"
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:appCategory="productivity"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:pageSizeCompat="enabled"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Dhizuku">

        <!-- ================================================================
             Xposed 模块声明。
             · 有 LSPosed / LSPatch 的用户：管理器把本 APK 识别为模块，
               勾选作用域后由 assets/xposed_init 加载 HookInit。
             · 没有它们的用户：这几行只是 manifest 里的普通 meta-data，
               系统不会加载 xposed_init，Java 侧 Xposed 类也不会被实例化，
               应用行为与集成前完全一致。
             · 不写 xposedscope：作用域由 HookConfigProvider 动态下发，
               也避免推荐列表里出现「系统框架」引导用户误勾。
             ================================================================ -->
        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription" android:value="@string/xposed_module_description" />
        <meta-data android:name="xposedminversion" android:value="54" />

        <activity
            android:name=".ui.activity.SettingsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.activity.RequestPermissionActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleInstance"
            android:theme="@style/Theme.Dhizuku.Translucent">
            <intent-filter>
                <action android:name="${applicationId}.action.request.permission" />
                <action android:name="${applicationId}.action.REQUEST_DHIZUKU_PERMISSION" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            原版 Dhizuku 的授权 action。硬编码官方包名的客户端会用固定 action
            发起授权请求，此处用 activity-alias 指向同一个 Activity，
            避免在主 intent-filter 里追加造成重复。
        -->
        <activity-alias
            android:name=".RequestPermissionOfficialEntry"
            android:targetActivity=".ui.activity.RequestPermissionActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="com.rosan.dhizuku.action.request.permission" />
                <action android:name="com.rosan.dhizuku.action.REQUEST_DHIZUKU_PERMISSION" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".ui.activity.ProvisioningActivity"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <intent-filter>
                <action android:name="android.app.action.GET_PROVISIONING_MODE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.activity.FinalizeActivity"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <intent-filter>
                <action android:name="android.app.action.ADMIN_POLICY_COMPLIANCE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 擦除设备数据的确认页：不导出，只能由本应用内部的通知拉起 -->
        <activity
            android:name=".ui.activity.WipeConfirmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Dhizuku" />

        <!-- 第三方转移设备所有者的二次确认页：由安全警示通知拉起 -->
        <activity
            android:name=".ui.activity.OwnerTransferConfirmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Dhizuku.Translucent" />

        <provider
            android:name=".server.MyDhizukuProvider"
            android:authorities="${dhizukuAuthorities}"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="${applicationId}.server.provider" />
            </intent-filter>
        </provider>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

        <!-- 模块配置 / 报到通道。exported 才能让被 hook 的第三方进程 call 进来；
             未启用时返回 disabled，模块保持 no-op。不提供 query/openFile。 -->
        <provider
            android:name=".server.HookConfigProvider"
            android:authorities="${applicationId}.hook.config"
            android:exported="true"
            android:enabled="true" />

        <service
            android:name=".server.DaemonService"
            android:enabled="true"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Maintains Dhizuku device-owner service availability for authorized apps." />
        </service>

        <!-- 内核实验室的 tun 报文通道。执行期间由 native 注入入站 IPv4 报文，
             结束或用户撤销授权时立即关闭。 -->
        <service
            android:name=".ui.page.settings.experimental.Cve98432VpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".server.DhizukuDAReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/dhizuku_device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.DEVICE_ADMIN_DISABLE_REQUESTED" />
                <action android:name="android.app.action.DEVICE_ADMIN_DISABLED" />
                <action android:name="android.app.action.DEVICE_OWNER_CHANGED" />
                <action android:name="android.app.action.PROFILE_OWNER_CHANGED" />
                <action android:name="android.app.action.PROFILE_PROVISIONING_COMPLETE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".server.DaemonReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <!-- booted receiver-->
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />

                <!-- 覆盖安装（含 adb install -r -t）后立刻刷新身份并拉起服务，
                     否则要等用户手动打开管理器，第三方会短暂连不上 binder。
                     MY_PACKAGE_REPLACED 只发给本包，属于静态注册豁免广播。 -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />

                <!-- device/profile owner changed receiver -->
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.DEVICE_ADMIN_DISABLE_REQUESTED" />
                <action android:name="android.app.action.DEVICE_ADMIN_DISABLED" />
                <action android:name="android.app.action.DEVICE_OWNER_CHANGED" />
                <action android:name="android.app.action.PROFILE_OWNER_CHANGED" />
                <action android:name="android.app.action.PROFILE_PROVISIONING_COMPLETE" />
            </intent-filter>
        </receiver>

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
